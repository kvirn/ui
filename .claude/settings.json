{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(vp check*)",
      "Bash(vp test*)",
      "Bash(vp lint*)",
      "Bash(vp fmt*)",
      "Bash(vp run *)",
      "Bash(node .claude/hooks/test-preflight.mjs*)",
      "Bash(pnpm install*)",
      "Bash(pnpm changeset*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git worktree add ../kvirn-*)",
      "Bash(git worktree list*)",
      "Bash(sed *)",
      "Bash(wc *)",
      "Read(//home/magnus-vike/Sites/kvirn-*/**)",
      "Edit(//home/magnus-vike/Sites/kvirn-*/**)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(git branch*)",
      "Bash(git merge*)",
      "Bash(git add*)",
      "Bash(git branch --show-current*)",
      "Bash(git commit*)",
      "Bash(pnpm add*)",
      "Bash(git worktree remove*)",
      "Bash(pnpm publish*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/format.sh\"" }
        ]
      }
    ]
  }
}
