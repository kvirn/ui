{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "agent": "lead",
  "outputStyle": "Concise",
  "permissions": {
    "allow": [
      "Bash(vp check*)",
      "Bash(vp lint*)",
      "Bash(vp fmt*)",
      "Bash(vp run *)",
      "Bash(node .claude/hooks/test-preflight.mjs*)",
      "Bash(pnpm install*)",
      "Bash(pnpm changeset*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git worktree add ../kvirn-*)",
      "Bash(git worktree list*)",
      "Bash(sed *)",
      "Bash(wc *)",
      "Read(//home/magnus-vike/Sites/kvirn-*/**)",
      "Edit(//home/magnus-vike/Sites/kvirn-*/**)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(git branch*)",
      "Bash(git merge*)",
      "Bash(git add*)",
      "Bash(git branch --show-current*)",
      "Bash(git commit*)",
      "Bash(pnpm add*)",
      "Bash(git worktree remove*)",
      "Bash(pnpm publish*)",
      "Bash(vp test*)",
      "Bash(vp run test*)",
      "Bash(pnpm test*)",
      "Bash(pnpm run test*)",
      "Bash(flock * vp test*)",
      "Bash(flock * vp run test*)",
      "Bash(flock * pnpm test*)",
      "Bash(flock * pnpm run test*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/format.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/tooling/gate-guard/gate-guard.ts\""
          }
        ]
      }
    ]
  }
}
