{
  "name": "kvirn-ui",
  "version": "0.0.0",
  "private": true,
  "license": "BUSL-1.1",
  "type": "module",
  "scripts": {
    "prepare": "vp config --hooks --no-agent",
    "storybook": "vp run --filter @kvirn-ui/storybook dev",
    "docs": "vp run --filter '@kvirn-ui/docs^...' build && vp run --parallel --filter @kvirn-ui/docs --filter @kvirn-ui/core --filter @kvirn-ui/i18n --filter @kvirn-ui/react --filter @kvirn-ui/theme dev",
    "build": "vp run -r build",
    "test": "vp test run --project node --project browser && node tooling/storybook-run/storybook-run.ts storybook storybook-dark storybook-light-contrast storybook-dark-contrast",
    "ci:docker": "node tooling/ci/docker-ci.ts",
    "i18n:check": "node packages/i18n/scripts/i18n-check.ts",
    "theme:check": "node packages/theme/scripts/theme-check.ts",
    "changeset": "changeset",
    "format": "vp fmt",
    "lint": "vp lint"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@kvirn-ui/testing": "workspace:*",
    "@storybook/addon-vitest": "catalog:",
    "@types/node": "catalog:",
    "playwright": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.8.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  }
}
