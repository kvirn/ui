{
  "extends": "./tooling/tsconfig/base.json",
  "include": [
    "*.ts",
    "packages/*/src",
    "packages/*/scripts",
    "tooling/ci",
    "tooling/gate-guard",
    "tooling/commit-message",
    "tooling/english-only",
    "tooling/keyboard-docs",
    "tooling/props-used",
    "tooling/raw-colours",
    "apps/storybook/.storybook",
    "apps/storybook/src"
  ],
  "compilerOptions": {
    "paths": {
      "@kvirn-ui/core": ["./packages/core/src/index.ts"],
      "@kvirn-ui/react": ["./packages/react/src/index.ts"],
      "@kvirn-ui/patterns": ["./packages/patterns/src/index.ts"],
      "@kvirn-ui/patterns/fixtures": ["./packages/patterns/src/fixtures/index.ts"],
      "@kvirn-ui/rich-text": ["./packages/rich-text/src/index.ts"],
      "@kvirn-ui/read-aloud": ["./packages/read-aloud/src/index.ts"],
      "@kvirn-ui/map": ["./packages/map/src/index.ts"],
      "@kvirn-ui/map/maplibre": ["./packages/map/src/maplibre.ts"],
      "@kvirn-ui/testing": ["./packages/testing/src/index.ts"],
      "@kvirn-ui/icons": ["./packages/icons/src/index.ts"],
      "@kvirn-ui/icons/all": ["./packages/icons/src/all.ts"],
      "@kvirn-ui/theme": ["./packages/theme/src/index.ts"],
      "@kvirn-ui/react/internal": ["./packages/react/src/internal.ts"],
      "@kvirn-ui/i18n": ["./packages/i18n/src/index.ts"],
      "@kvirn-ui/i18n/en": ["./packages/i18n/src/locales/en.ts"],
      "@kvirn-ui/i18n/sv": ["./packages/i18n/src/locales/sv.ts"],
      "@kvirn-ui/i18n/fi": ["./packages/i18n/src/locales/fi.ts"],
      "@kvirn-ui/i18n/nb": ["./packages/i18n/src/locales/nb.ts"],
      "@kvirn-ui/i18n/nn": ["./packages/i18n/src/locales/nn.ts"],
      "@kvirn-ui/i18n/se": ["./packages/i18n/src/locales/se.ts"]
    }
  }
}
