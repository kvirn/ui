{
  "name": "@kvirn-ui/icons",
  "version": "0.0.0",
  "description": "Outline icons on one 24 grid, as plain data, with no dependencies. Each icon is tree-shakeable, and a small React component draws it.",
  "homepage": "https://ui.kvirn.com",
  "license": "MIT",
  "author": "KvirnUI <magnus@vike.se> (https://ui.kvirn.com)",
  "files": [
    "dist",
    "LICENSING.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./all": {
      "import": {
        "types": "./dist/all.d.mts",
        "default": "./dist/all.mjs"
      },
      "require": {
        "types": "./dist/all.d.cts",
        "default": "./dist/all.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.mts",
        "default": "./dist/react.mjs"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../tooling/clean-src-dts/clean-src-dts.ts && vp pack",
    "generate": "node scripts/generate.mjs"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "react": ">=19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
