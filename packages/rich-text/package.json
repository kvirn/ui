{
  "name": "@kvirn-ui/rich-text",
  "version": "0.0.0",
  "description": "An accessible rich text editor for KvirnUI, built on Tiptap.",
  "homepage": "https://ui.kvirn.com",
  "license": "AGPL-3.0-only",
  "author": "KvirnUI <magnus@vike.se> (https://ui.kvirn.com)",
  "files": [
    "dist",
    "LICENSING.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack"
  },
  "dependencies": {
    "@kvirn-ui/core": "workspace:*",
    "@kvirn-ui/i18n": "workspace:*",
    "@kvirn-ui/react": "workspace:*"
  },
  "devDependencies": {
    "@kvirn-ui/testing": "workspace:*",
    "@tiptap/core": "catalog:",
    "@tiptap/extension-image": "catalog:",
    "@tiptap/extension-table": "catalog:",
    "@tiptap/extensions": "catalog:",
    "@tiptap/pm": "catalog:",
    "@tiptap/react": "catalog:",
    "@tiptap/starter-kit": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vite-plus": "catalog:",
    "vitest-browser-react": "catalog:"
  },
  "peerDependencies": {
    "@tiptap/core": "^3.31.0",
    "@tiptap/extension-image": "^3.31.0",
    "@tiptap/extension-table": "^3.31.0",
    "@tiptap/extensions": "^3.31.0",
    "@tiptap/pm": "^3.31.0",
    "@tiptap/react": "^3.31.0",
    "@tiptap/starter-kit": "^3.31.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  }
}
