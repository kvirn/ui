{
  "name": "@kvirn-ui/react",
  "version": "0.0.0",
  "description": "Headless, accessible React hooks and components for KvirnUI.",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./internal": "./src/internal.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      },
      "./internal": {
        "types": "./dist/internal.d.mts",
        "import": "./dist/internal.mjs"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack"
  },
  "dependencies": {
    "@kvirn-ui/core": "workspace:*",
    "@kvirn-ui/i18n": "workspace:*"
  },
  "devDependencies": {
    "@heroicons/react": "catalog:",
    "@kvirn-ui/testing": "workspace:*",
    "@phosphor-icons/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vite-plus": "catalog:",
    "vitest-browser-react": "catalog:"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  }
}
