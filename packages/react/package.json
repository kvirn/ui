{
  "name": "@kvirn/ui",
  "version": "0.0.0",
  "description": "Headless, accessible React hooks and components for KvirnUI.",
  "homepage": "https://ui.kvirn.com",
  "license": "BUSL-1.1",
  "author": "KvirnUI <magnus@vike.se> (https://ui.kvirn.com)",
  "files": [
    "dist",
    "LICENSING.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./internal": {
      "types": "./dist/internal.d.mts",
      "default": "./dist/internal.mjs"
    },
    "./server": {
      "types": "./dist/server.d.mts",
      "default": "./dist/server.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../tooling/clean-src-dts/clean-src-dts.ts && vp pack",
    "dev": "vp pack --watch --no-clean"
  },
  "dependencies": {
    "@kvirn/core": "workspace:*",
    "@kvirn/i18n": "workspace:*",
    "@kvirn/icons": "workspace:*"
  },
  "devDependencies": {
    "@heroicons/react": "catalog:",
    "@kvirn/testing": "workspace:*",
    "@phosphor-icons/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vite-plus": "catalog:",
    "vitest-browser-react": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
}
