{
  "name": "@kvirn-ui/react",
  "version": "0.0.0",
  "description": "Headless, accessible React hooks and components for KvirnUI.",
  "homepage": "https://ui.kvirn.com",
  "license": "AGPL-3.0-only",
  "author": "KvirnUI <magnus@vike.se> (https://ui.kvirn.com)",
  "files": [
    "dist",
    "LICENSING.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./internal": {
      "import": {
        "types": "./dist/internal.d.mts",
        "default": "./dist/internal.mjs"
      },
      "require": {
        "types": "./dist/internal.d.cts",
        "default": "./dist/internal.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch"
  },
  "dependencies": {
    "@kvirn-ui/core": "workspace:*",
    "@kvirn-ui/i18n": "workspace:*"
  },
  "devDependencies": {
    "@heroicons/react": "catalog:",
    "@kvirn-ui/testing": "workspace:*",
    "@phosphor-icons/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vite-plus": "catalog:",
    "vitest-browser-react": "catalog:"
  },
  "peerDependencies": {
    "react": ">=19.0.0"
  }
}
