{
  "name": "@kvirn-ui/read-aloud",
  "version": "0.0.0",
  "private": true,
  "description": "Read a region of the page aloud with the browser's own speech, in planning for 1.2.",
  "homepage": "https://ui.kvirn.com",
  "license": "BUSL-1.1",
  "author": "KvirnUI <magnus@vike.se> (https://ui.kvirn.com)",
  "files": [
    "dist",
    "LICENSING.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack"
  },
  "dependencies": {
    "@kvirn-ui/core": "workspace:*",
    "@kvirn-ui/i18n": "workspace:*",
    "@kvirn-ui/icons": "workspace:*",
    "@kvirn-ui/react": "workspace:*"
  },
  "devDependencies": {
    "@kvirn-ui/testing": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vite-plus": "catalog:",
    "vitest-browser-react": "catalog:"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  }
}
