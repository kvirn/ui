{
  "name": "@kvirn-ui/i18n",
  "version": "0.0.0",
  "description": "KvirnUI message catalogs for sv, fi, nb, nn and en.",
  "homepage": "https://ui.kvirn.com",
  "license": "AGPL-3.0-only",
  "author": "KvirnUI <magnus@vike.se> (https://ui.kvirn.com)",
  "files": [
    "dist",
    "LICENSING.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./en": {
      "import": {
        "types": "./dist/locales/en.d.mts",
        "default": "./dist/locales/en.mjs"
      },
      "require": {
        "types": "./dist/locales/en.d.cts",
        "default": "./dist/locales/en.cjs"
      }
    },
    "./sv": {
      "import": {
        "types": "./dist/locales/sv.d.mts",
        "default": "./dist/locales/sv.mjs"
      },
      "require": {
        "types": "./dist/locales/sv.d.cts",
        "default": "./dist/locales/sv.cjs"
      }
    },
    "./fi": {
      "import": {
        "types": "./dist/locales/fi.d.mts",
        "default": "./dist/locales/fi.mjs"
      },
      "require": {
        "types": "./dist/locales/fi.d.cts",
        "default": "./dist/locales/fi.cjs"
      }
    },
    "./nb": {
      "import": {
        "types": "./dist/locales/nb.d.mts",
        "default": "./dist/locales/nb.mjs"
      },
      "require": {
        "types": "./dist/locales/nb.d.cts",
        "default": "./dist/locales/nb.cjs"
      }
    },
    "./nn": {
      "import": {
        "types": "./dist/locales/nn.d.mts",
        "default": "./dist/locales/nn.mjs"
      },
      "require": {
        "types": "./dist/locales/nn.d.cts",
        "default": "./dist/locales/nn.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch --no-clean"
  },
  "devDependencies": {
    "vite-plus": "catalog:"
  }
}
