{
  "name": "@kvirn-ui/core",
  "version": "0.0.0",
  "description": "Framework-agnostic state and interaction logic for KvirnUI.",
  "homepage": "https://ui.kvirn.com",
  "license": "AGPL-3.0-only",
  "author": "KvirnUI <magnus@vike.se> (https://ui.kvirn.com)",
  "files": [
    "dist",
    "LICENSING.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch"
  },
  "dependencies": {
    "@tanstack/store": "catalog:",
    "@tanstack/table-core": "catalog:",
    "@tanstack/virtual-core": "catalog:"
  },
  "devDependencies": {
    "vite-plus": "catalog:"
  }
}
