{
  "name": "@kvirn-ui/map",
  "version": "0.0.0",
  "private": true,
  "description": "An accessible map for KvirnUI: the viewport, places and address search on a replaceable engine.",
  "homepage": "https://ui.kvirn.com",
  "license": "BUSL-1.1",
  "author": "KvirnUI <magnus@vike.se> (https://ui.kvirn.com)",
  "files": [
    "dist",
    "LICENSING.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./maplibre": {
      "import": {
        "types": "./dist/maplibre.d.mts",
        "default": "./dist/maplibre.mjs"
      },
      "require": {
        "types": "./dist/maplibre.d.cts",
        "default": "./dist/maplibre.cjs"
      }
    },
    "./leaflet": {
      "import": {
        "types": "./dist/leaflet.d.mts",
        "default": "./dist/leaflet.mjs"
      },
      "require": {
        "types": "./dist/leaflet.d.cts",
        "default": "./dist/leaflet.cjs"
      }
    },
    "./google": {
      "import": {
        "types": "./dist/google.d.mts",
        "default": "./dist/google.mjs"
      },
      "require": {
        "types": "./dist/google.d.cts",
        "default": "./dist/google.cjs"
      }
    },
    "./google-places": {
      "import": {
        "types": "./dist/google-places.d.mts",
        "default": "./dist/google-places.mjs"
      },
      "require": {
        "types": "./dist/google-places.d.cts",
        "default": "./dist/google-places.cjs"
      }
    },
    "./nominatim": {
      "import": {
        "types": "./dist/nominatim.d.mts",
        "default": "./dist/nominatim.mjs"
      },
      "require": {
        "types": "./dist/nominatim.d.cts",
        "default": "./dist/nominatim.cjs"
      }
    },
    "./kvirn": {
      "import": {
        "types": "./dist/kvirn.d.mts",
        "default": "./dist/kvirn.mjs"
      },
      "require": {
        "types": "./dist/kvirn.d.cts",
        "default": "./dist/kvirn.cjs"
      }
    },
    "./worker": {
      "import": {
        "types": "./dist/worker.d.mts",
        "default": "./dist/worker.mjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack"
  },
  "dependencies": {
    "@kvirn-ui/core": "workspace:*",
    "@kvirn-ui/i18n": "workspace:*",
    "@kvirn-ui/icons": "workspace:*",
    "@kvirn-ui/react": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "leaflet": "catalog:",
    "maplibre-gl": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vite-plus": "catalog:",
    "vitest-browser-react": "catalog:"
  },
  "peerDependencies": {
    "leaflet": "^1.9.4",
    "maplibre-gl": "^6.14.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "peerDependenciesMeta": {
    "leaflet": {
      "optional": true
    },
    "maplibre-gl": {
      "optional": true
    }
  }
}
