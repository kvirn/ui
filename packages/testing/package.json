{
  "name": "@kvirn-ui/testing",
  "version": "0.0.0",
  "description": "Accessibility test helpers for KvirnUI (Vitest browser mode).",
  "homepage": "https://ui.kvirn.com",
  "license": "AGPL-3.0-only",
  "author": "KvirnUI <magnus@vike.se> (https://ui.kvirn.com)",
  "files": [
    "dist",
    "LICENSING.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./read-aloud": {
      "import": {
        "types": "./dist/read-aloud.d.mts",
        "default": "./dist/read-aloud.mjs"
      },
      "require": {
        "types": "./dist/read-aloud.d.cts",
        "default": "./dist/read-aloud.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack"
  },
  "dependencies": {
    "axe-core": "catalog:"
  },
  "devDependencies": {
    "@guidepup/virtual-screen-reader": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@guidepup/virtual-screen-reader": "~0.33.0"
  },
  "peerDependenciesMeta": {
    "@guidepup/virtual-screen-reader": {
      "optional": true
    }
  }
}
