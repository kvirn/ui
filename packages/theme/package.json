{
  "name": "@kvirn/theme",
  "version": "0.0.0",
  "description": "Optional default theme for KvirnUI: one readable theme.css with --kv-* tokens and component styles.",
  "homepage": "https://ui.kvirn.com",
  "license": "BUSL-1.1",
  "author": "KvirnUI <magnus@vike.se> (https://ui.kvirn.com)",
  "files": [
    "dist",
    "grid.css",
    "map.css",
    "patterns.css",
    "read-aloud.css",
    "reset.css",
    "rich-text.css",
    "theme.css",
    "LICENSING.md"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./map.css": "./map.css",
    "./read-aloud.css": "./read-aloud.css",
    "./reset.css": "./reset.css",
    "./rich-text.css": "./rich-text.css",
    "./theme.css": "./theme.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch --no-clean",
    "grid:generate": "node scripts/grid.ts"
  },
  "devDependencies": {
    "vite-plus": "catalog:"
  }
}
