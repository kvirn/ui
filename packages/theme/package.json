{
  "name": "@kvirn-ui/theme",
  "version": "0.0.0",
  "description": "Optional default theme for KvirnUI: one readable theme.css with --kv-* tokens and component styles.",
  "license": "MIT",
  "files": [
    "dist",
    "reset.css",
    "theme.css"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./reset.css": "./reset.css",
    "./theme.css": "./theme.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      },
      "./reset.css": "./reset.css",
      "./theme.css": "./theme.css",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack"
  },
  "devDependencies": {
    "vite-plus": "catalog:"
  }
}
